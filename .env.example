# ===========================================================================
# JOC — Juice On Choice | Environment variables
#
# Copy to `.env.local` for local development:
#     cp .env.example .env.local
#
# `.env`, `.env.local` and `.env*.local` are git-ignored. Never commit real
# values, and never paste a secret into a source file.
#
# Vercel: Project Settings -> Environment Variables. Add each name below for
# Preview and Production.
# ===========================================================================

# ---------------------------------------------------------------------------
# Database — required for real orders
# ---------------------------------------------------------------------------
# Supabase Postgres connection string, or any Postgres URL.
# Use the Supavisor *transaction pooler* URL on Vercel serverless functions.
#
# NEW database:  run db/schema.sql in the Supabase SQL editor once to create
#                everything, or leave JOC_AUTO_MIGRATE=true and let the API do it
#                on first request.
# EXISTING database (one that already has orders):  run the files in
#                db/migrations/ in order (…003, then 004_delivery_and_notifications).
#                Use the SQL editor or the *direct* connection — the transaction
#                pooler will not run a multi-statement migration file.
#                Apply migrations BEFORE deploying code that writes the new columns.
#
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Set to "false" if you provision the schema yourself and want no DDL at runtime.
# Keep this false in production once the migrations are applied.
JOC_AUTO_MIGRATE=true

# Set to "false" only if your provider already terminates TLS (local Postgres).
# DATABASE_SSL=true

# Local-development safety net: without DATABASE_URL the API keeps orders in
# memory (clearly labelled demo mode). On Vercel Production that memory store is
# refused by default so a missing database can never silently lose orders. Only
# set this to "true" for a temporary demo build you fully understand.
# JOC_ALLOW_MEMORY_STORE=true

# ===========================================================================
# PAYMENT  — read this first
# ===========================================================================
# Cash on Delivery is ALWAYS available and needs no configuration at all.
#
# The UPI option at checkout appears only when BOTH of the two variables below
# are set. If JOC_UPI_ID is missing or malformed, the checkout deliberately
# offers Cash on Delivery only and says so — that is the "Online payment is
# unavailable right now" message, and it is the single most common reason a
# deployment shows COD only.
#
# Neither variable is a secret. JOC_UPI_ID is printed to customers on purpose
# (they have to type it into their own UPI app), and neither may be prefixed
# with VITE_ — the checkout reads them from /api/payments/methods at runtime,
# so a newly configured rail appears with no frontend release.
# ===========================================================================

# Which rail settles a digital payment. One of: manual_upi | razorpay
# Anything unrecognised falls back to manual_upi, so this is safe to leave blank.
JOC_PAYMENT_PROVIDER=manual_upi

# The UPI ID customers pay to: handle@bank, e.g. 9630194023@pthdfc
# NOT a secret — it is shown on the checkout and on the order confirmation
# screen, and it is embedded in the payment QR.
# Required for manual UPI. Leave unset to run Cash on Delivery only.
# JOC_UPI_ID=

# ---------------------------------------------------------------------------
# Razorpay — only used when JOC_PAYMENT_PROVIDER=razorpay
# ---------------------------------------------------------------------------
# Not used while JOC_PAYMENT_PROVIDER=manual_upi. Razorpay stays behind the
# provider abstraction so it can be enabled later by changing one variable.
#
# SERVER ONLY. This is the secret. It must never be exposed to the browser,
# must never be prefixed with VITE_, and must never be committed.
# Test keys come from https://dashboard.razorpay.com/app/keys (Test Mode).
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SERVER ONLY. The publishable key id. Safe to keep server-side; the checkout
# script receives it from /api/payments/create at runtime, so the browser bundle
# does not need it either.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx

# Defaults to "true", so live payments cannot be enabled by accident. Flip only
# once real live keys are configured and the flow has been tested end to end.
RAZORPAY_TEST_MODE=true

# ---------------------------------------------------------------------------
# Delivery area - REQUIRED. Without this, no order can be placed at all.
# ---------------------------------------------------------------------------
# JOC delivers only within a fixed DRIVING distance of the store, measured by the
# Google Routes API and compared against the radius below. It is never a
# straight-line distance: a 4 km crow-flies address in Jabalpur can be 9 km by
# road, and the road number is the one a rider actually drives.
#
# The rule is enforced in exactly one place (api/_lib/delivery.js) and is
# re-checked when the order is placed, so the figure the customer sees while
# typing their address can never be the thing that decides the order.
#
# It FAILS CLOSED. If the key is missing, the coordinates are missing, or Google
# cannot be reached, the answer is "we cannot deliver to that address", not
# "sure, go ahead". An outage of this dependency must never widen the delivery
# area.
#
# Two Google APIs must be ENABLED on the key:
#   * Geocoding API  (turns the typed address into a point)
#   * Routes API     (measures the driving distance between two points)
#
# SERVER ONLY. Never prefix with VITE_, never commit, never log.
# GOOGLE_MAPS_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Store coordinates, as decimal degrees.
#
# GET THEM FROM GOOGLE, DO NOT GUESS THEM. Search the store address in Google
# Maps, right-click the pin -> "Copy plus code" / the coordinates in the URL, and
# paste the latitude/longitude here. A wrong pin shifts the whole delivery area,
# and nothing in the app can tell you it is wrong.
#
# Reference address:
#   Plot No. 207, near Shri Ram Engineering College, Dixit Colony,
#   Rajeev Gandhi Nagar, Marhatal, Jabalpur, Madhya Pradesh 482002
#   Plus Code: 6W25+66 Jabalpur, Madhya Pradesh
# JOC_STORE_LATITUDE=23.1815
# JOC_STORE_LONGITUDE=79.9864

# The delivery radius in kilometres, inclusive: an address exactly at the limit is
# deliverable. Accepts sloppy operator input ("4", " 4 ", "7.5km") and clamps a
# mistyped value to a sane 0.5-50 km, so "0" or "-3" cannot quietly reject every
# order. The current JOC rule is 4 km.
JOC_DELIVERY_RADIUS_KM=4

# Public base URL of the site, used only to build the customer's tracking link
# (https://site/#/order/JOC-...?t=<token>). The token is in the URL FRAGMENT on
# purpose: fragments are never sent to a server, so the secret cannot end up in an
# access log. Unset falls back to the production URL.
# JOC_SITE_URL=https://joc.vercel.app

# ---------------------------------------------------------------------------
# Admin dashboard - required to verify UPI payments at /admin/orders
# ---------------------------------------------------------------------------

# Supabase Auth credentials for the one admin account. The anon key is enough:
# it only grants the ability to exchange a password for a session, and RLS is
# enabled with no policies, so the anon key cannot read any table.
# Never put a Supabase *password*, service-role key or session secret here.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOi...

# At least 32 characters, random. Signs the admin session cookie.
# Changing it logs every admin out. Never commit this value.
# JOC_ADMIN_SESSION_SECRET=

# Optional allow-list. Empty means "any Supabase user who can sign in", which is
# fine when exactly one admin account exists.
# JOC_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Notifications — optional, never affect whether an order succeeds
# ---------------------------------------------------------------------------
# Email via Resend. All three are required before email is sent; without them
# the dashboard and browser notification still work. WhatsApp is not configured.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
# JOC_NOTIFY_FROM=
# JOC_NOTIFY_EMAIL=

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# There is intentionally no VITE_RAZORPAY_KEY_ID. The public key id is served
# per request by /api/payments/create, which keeps the payment surface in one
# place and means the browser bundle never has to know about credentials.
#
# Delivery pricing is NOT an environment variable — it is a code-level business
# rule and lives in shared/ordering.js (DELIVERY_CHARGE, FREE_DELIVERY_ABOVE).
