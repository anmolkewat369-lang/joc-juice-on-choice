# ===========================================================================
# JOC — Juice On Choice | Environment variables
#
# Copy to `.env.local` for local development:
#     cp .env.example .env.local
#
# `.env`, `.env.local` and `.env*.local` are git-ignored. Never commit real
# values, and never paste a secret into a source file.
#
# Vercel: Project Settings -> Environment Variables. Add each name below for
# Preview and Production.
# ===========================================================================

# ---------------------------------------------------------------------------
# Database — required for real orders
# ---------------------------------------------------------------------------
# Supabase Postgres connection string, or any Postgres URL.
# Use the Supavisor *transaction pooler* URL on Vercel serverless functions.
# Run db/schema.sql in the Supabase SQL editor once to create the table, or let
# the API create it on first request (set JOC_AUTO_MIGRATE=false to disable).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Set to "false" if you provision the schema yourself and want no DDL at runtime.
JOC_AUTO_MIGRATE=true

# Set to "false" only if your provider already terminates TLS (local Postgres).
# DATABASE_SSL=true

# Local-development safety net: without DATABASE_URL the API keeps orders in
# memory (clearly labelled demo mode). On Vercel Production that memory store is
# refused by default so a missing database can never silently lose orders. Only
# set this to "true" for a temporary demo build you fully understand.
# JOC_ALLOW_MEMORY_STORE=true

# ---------------------------------------------------------------------------
# Razorpay — required for "Pay Now"
# ---------------------------------------------------------------------------
# SERVER ONLY. This is the secret. It must never be exposed to the browser,
# must never be prefixed with VITE_, and must never be committed.
# Test keys come from https://dashboard.razorpay.com/app/keys (Test Mode).
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SERVER ONLY. The publishable key id. Safe to keep server-side; the checkout
# script receives it from /api/payments/create at runtime, so the browser bundle
# does not need it either.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx

# Defaults to "true", so live payments cannot be enabled by accident. Flip only
# once real live keys are configured and the flow has been tested end to end.
RAZORPAY_TEST_MODE=true

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# There is intentionally no VITE_RAZORPAY_KEY_ID. The public key id is served
# per request by /api/payments/create, which keeps the payment surface in one
# place and means the browser bundle never has to know about credentials.
#
# Delivery pricing is NOT an environment variable — it is a code-level business
# rule and lives in shared/ordering.js (DELIVERY_CHARGE, FREE_DELIVERY_ABOVE).
